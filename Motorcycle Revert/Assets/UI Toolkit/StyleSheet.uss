.label {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=3886a9b994b924d46ad05d7e24a1c398&type=3#NotInter-Regular");
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    font-size: 105%;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    border-top-width: 24px;
    border-right-width: 24px;
    border-bottom-width: 24px;
    border-left-width: 24px;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-left-color: rgba(0, 0, 0, 0.32);
    border-right-color: rgba(0, 0, 0, 0.32);
    border-top-color: rgba(0, 0, 0, 0.32);
    border-bottom-color: rgba(0, 0, 0, 0.32);
    background-color: rgb(71, 72, 82);
}

.button {
    flex-grow: 1;
    font-size: 897%;
    -unity-text-align: middle-center;
    flex-shrink: 1;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out-sine;
    background-color: rgb(71, 72, 82);
    -unity-text-outline-width: 9px;
    -unity-text-outline-color: rgb(0, 0, 0);
    flex-direction: column;
    align-self: stretch;
    align-content: flex-end;
    justify-content: space-around;
    align-items: flex-start;
}

.button:hover {
    font-size: 1012%;
    transition-timing-function: ease-out-back;
    transition-duration: 0.2s;
    scale: 1 1;
    rotate: 0;
    flex-grow: 1.2;
    translate: 0 -5%;
    background-color: rgb(75, 81, 101);
}
