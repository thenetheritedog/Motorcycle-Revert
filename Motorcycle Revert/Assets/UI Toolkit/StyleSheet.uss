.label {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=3886a9b994b924d46ad05d7e24a1c398&type=3#NotInter-Regular");
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    font-size: 105%;
    color: rgb(255, 255, 255);
}

.button {
    flex-grow: 1;
    font-size: 242%;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out-sine;
    background-color: rgb(71, 72, 82);
}

.button:hover {
    font-size: 245%;
    transition-timing-function: ease-out-back;
    transition-duration: 0.2s;
    scale: 1 1;
    rotate: 0;
    flex-grow: 2;
    translate: 0 -11%;
    background-color: rgb(75, 81, 101);
}
