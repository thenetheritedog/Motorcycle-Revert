<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheet.uss?fileID=7433441132597879392&amp;guid=aada47d6f13b431419547420da134b5a&amp;type=3#StyleSheet" />
    <ui:VisualElement name="ROOT" style="flex-grow: 1; color: rgb(0, 0, 0); background-color: rgb(101, 90, 86); flex-direction: row; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 24px; border-right-width: 24px; border-bottom-width: 24px; border-left-width: 24px;">
        <ui:VisualElement name="Left" style="flex-grow: 1;">
            <ui:Label text="Motorcycle&#10;REVERT" name="Title" class="label" style="font-size: 182%; -unity-text-align: upper-left; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%;" />
            <ui:VisualElement name="Buttons" style="flex-grow: 1; flex-direction: row; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; -unity-text-align: upper-left; justify-content: flex-start; align-items: stretch; align-self: stretch; align-content: flex-start;">
                <ui:Button text="Start" name="Start" class="button label" style="flex-shrink: 1;" />
                <ui:Button text="Quit" name="Quit" enabled="true" class="button label" style="flex-shrink: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Right" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: auto; width: 27%; justify-content: center; flex-direction: column-reverse; flex-shrink: 1;">
            <ui:Label text="Left and right to control movement&#10;Space to jump&#10;Click to destroy&#10;Release to repair&#10;Drive away from the death fog, you cannot stop and it is constantly going faster and faster. You have the ability to destroy objects and then repair them to a previous state. Reach the Highest score you can!" name="Label" class="label" style="white-space: normal; letter-spacing: 0; -unity-paragraph-spacing: 91px; word-spacing: 0; font-size: 40%; -unity-text-outline-width: 1px; -unity-text-align: middle-center; margin-top: 0; margin-right: 0; align-self: center; justify-content: center; align-items: stretch; align-content: flex-start; padding-top: 21px; padding-right: 21px; padding-bottom: 21px; padding-left: 21px; margin-bottom: 0; margin-left: 0; border-top-width: 29px; border-right-width: 29px; border-bottom-width: 29px; border-left-width: 29px; flex-shrink: 1; flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
